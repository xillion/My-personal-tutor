# (нужны только для автодополнения в редакторе). gen/android и gen/apple (Фаза 8) коммитятся.
src-tauri/gen/schemas/

# Node / SvelteKit
node_modules/
build/
.svelte-kit/
vite.config.ts.timestamp-*
# Paraglide: генерируется Vite-плагином и `pnpm i18n` из messages/*.json (T-001.3)
src/lib/paraglide/
project.inlang/cache/
.env
.env.*
!.env.example

# Сборки курсов и кэш компилятора
dist/
.mptc-cache/

# Локальные настройки Claude Code (не коммитятся)
.claude/settings.local.json
.claude/.headroom*

