{
  "name": "my-personal-tutor",
  "version": "0.0.0",
  "description": "Offline-first learning app for children: smart reader, vocabulary with spaced repetition, quizzes.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "node scripts/prepare.mjs",
    "i18n": "paraglide-js compile --project ./project.inlang --silent",
    "check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:offline": "node scripts/check-no-external-urls.mjs build",
    "check:licenses": "node scripts/check-npm-licenses.mjs",
    "lint": "pnpm i18n && prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.59.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tauri-apps/api": "^2.12.5",
    "bits-ui": "^2.22.0"
  }
}
